{
  "extends": ["@tsconfig/strictest"],
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"]
  },
  "include": ["src/preload/**/*"]
}
